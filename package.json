{
  "name": "harness-kit",
  "version": "1.1.92",
  "description": "DeepSeek Harness 本地补丁插件（右侧 dock 面板：清洗 / 演练台）。本地构建，个人使用。",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "harness-kit": "bin/harness-kit.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "harness-patch"
  ]
}